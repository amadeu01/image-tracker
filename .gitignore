# Rust
/target
**/target
# Cargo.lock is tracked (binary crate workspace) — do not ignore it

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Tool output (generated artifacts, not sources)
/out/
*.csv
!tests/fixtures/**/*.csv

# NOTE: test_videos/ is intentionally TRACKED — do not add it here.

# Ground-truth sampled frames are regenerable via groundtruth/extract_frames.sh;
# the hand labels (groundtruth/v*.csv) are the committed source of truth.
!groundtruth/v*.csv
/groundtruth/frames/
/groundtruth/*_verify.png

# graphify: graph is rebuilt by the post-commit hook, so a tracked copy would be dirty after every commit
/graphify-out/
.claude/*.graphify-bak

# Written by `cargo test` (overlay export test); not a source file
/crates/tracker-app/x.overlay.mp4
